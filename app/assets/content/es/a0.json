   "source": "3lang-original",
   "license": "CC BY-SA 4.0",
   "needsReview": false
  },
  {
   "id": "es.a0.sent.a24",
   "text": "La semana tiene siete días.",
   "translations": {
    "ar": "الأسبوع فيه سبع أيام.",
