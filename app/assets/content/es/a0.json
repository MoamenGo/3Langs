    "en": "The school is new."
   },
   "source": "3lang-original",
   "license": "CC BY-SA 4.0",
   "needsReview": false
  },
  {
   "id": "es.a0.sent.a08",
   "text": "¿Dónde está el coche?",
   "translations": {
