 "texts": [
  {
   "id": "es.a0.text.hotel",
   "level": "A0",
   "kind": "reading",
   "title": "En el hotel",
   "body": "Omar: ¡Hola! ¿Habla inglés?\nRecepción: Un poco. ¿Y español?\nOmar: Aprendo español, pero despacio. ¿Dónde está el aseo?\nRecepción: Allí.\nOmar: ¡Gracias! ¿Y cuándo viene el taxi?\nRecepción: Hoy, a las doce.",
   "translation": {
