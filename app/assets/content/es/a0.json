    "en": "I don't work on Saturday and Sunday."
   },
   "source": "3lang-original",
   "license": "CC BY-SA 4.0",
   "needsReview": false
  },
  {
   "id": "es.a0.sent.a27",
   "text": "¡Hasta el viernes!",
   "translations": {
    "ar": "أشوفك يوم الجمعة!",
