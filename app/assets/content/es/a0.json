   "source": "3lang-original",
   "license": "CC BY-SA 4.0",
   "needsReview": false
  },
  {
   "id": "es.a0.sent.a28",
   "text": "La clase es el miércoles y el jueves.",
   "translations": {
    "ar": "الدرس يوم الأربع والخميس.",
    "en": "The class is on Wednesday and Thursday."
   },
   "source": "3lang-original",
   "license": "CC BY-SA 4.0",
   "needsReview": false
  },
  {
   "id": "es.a0.sent.a29",
   "text": "Once, doce… ¡cien!",
   "translations": {
    "ar": "حداشر، اتناشر … مية!",
    "en": "Eleven, twelve … a hundred!"
