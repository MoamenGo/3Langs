   "source": "3lang-original",
   "license": "CC BY-SA 4.0",
   "needsReview": false
  },
  {
   "id": "es.a0.sent.a06",
   "text": "Una pizza y un plátano, por favor.",
   "translations": {
    "ar": "بيتزا وموزة، من فضلك.",
    "en": "A pizza and a banana, please."
   },
   "source": "3lang-original",
   "license": "CC BY-SA 4.0",
   "needsReview": false
  },
  {
   "id": "es.a0.sent.a07",
   "text": "La escuela es nueva.",
   "translations": {
