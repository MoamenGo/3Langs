    "en": "Tomorrow is Tuesday."
   },
   "source": "3lang-original",
   "license": "CC BY-SA 4.0",
   "needsReview": false
  },
  {
   "id": "es.a0.sent.a23",
   "text": "Ayer fue domingo.",
   "translations": {
    "ar": "امبارح كان الحد.",
    "en": "Yesterday was Sunday."
