 "texts": [
  {
   "id": "a1.text.sara",
   "level": "A1",
   "kind": "reading",
   "title": "Hallo, ich bin Sara!",
   "body": "Hallo! Ich heiße Sara. Ich komme aus Spanien, aus Madrid. Jetzt wohne ich in Berlin. Berlin ist eine große Stadt. Ich lerne Deutsch. Das ist mein Freund Tom. Er kommt aus England und wohnt auch in Berlin.",
   "translation": {
    "en": "Hello! My name is Sara. I come from Spain, from Madrid. Now I live in Berlin. Berlin is a big city. I'm learning German. This is my friend Tom. He comes from England and also lives in Berlin.",
    "nl": "Hallo! Ik heet Sara. Ik kom uit Spanje, uit Madrid. Nu woon ik in Berlijn. Berlijn is een grote stad. Ik leer Duits. Dit is mijn vriend Tom. Hij komt uit Engeland en woont ook in Berlijn.",
    "es": "¡Hola! Me llamo Sara. Soy de España, de Madrid. Ahora vivo en Berlín. Berlín es una ciudad grande. Estoy aprendiendo alemán. Este es mi amigo Tom. Es de Inglaterra y también vive en Berlín."
   },
