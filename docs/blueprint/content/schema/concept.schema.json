{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "3lang/concepts.schema.json",
  "title": "Shared curriculum: concepts and shared units (one file, all languages)",
  "type": "object",
  "required": ["schemaVersion", "contentVersion", "units", "concepts"],
  "properties": {
    "schemaVersion": {"const": 2},
    "contentVersion": {"type": "string"},
    "units": {"type": "array", "items": {"$ref": "#/$defs/sharedUnit"}},
    "concepts": {"type": "array", "items": {"$ref": "#/$defs/concept"}}
  },
  "$defs": {
    "level": {"enum": ["A0", "A1", "A2", "B1", "B2", "C1"]},
    "explain": {"type": "object", "required": ["ar"], "properties": {"ar": {"type": "string"}, "en": {"type": "string"}}, "additionalProperties": false},
    "sharedUnit": {
      "type": "object",
      "required": ["id", "level", "order", "theme", "canDo", "conceptIds"],
      "properties": {
        "id": {"type": "string", "pattern": "^u\\.(a0|a1|a2|b1|b2|c1)\\.[0-9]{2}$"},
        "level": {"$ref": "#/$defs/level"},
        "order": {"type": "integer", "minimum": 1},
        "theme": {"$ref": "#/$defs/explain"},
        "canDo": {"type": "array", "items": {"$ref": "#/$defs/explain"}},
        "conceptIds": {"type": "array", "items": {"type": "string"}}
      }
    },
    "concept": {
      "type": "object",
      "required": ["id", "level", "kind", "gloss"],
      "properties": {
        "id": {"type": "string", "pattern": "^c\\.(a0|a1|a2|b1|b2|c1)\\.[a-z0-9_.]+$"},
        "level": {"$ref": "#/$defs/level"},
        "kind": {"enum": ["sense", "function", "grammar", "theme"]},
        "gloss": {"$ref": "#/$defs/explain"},
        "image": {"type": "string"},
        "prerequisites": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
